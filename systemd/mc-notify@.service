[Unit]
Description=Minecraft Discord notifier (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=mc-notify
Group=mc-notify
EnvironmentFile=/etc/mc-notify/%i.env
ExecStart=/usr/bin/python3 /opt/mc-notify/mc_notify.py
Restart=always
RestartSec=10
# 狀態看板的訊息 ID 存在 /var/lib/mc-notify/<實例名稱>
StateDirectory=mc-notify/%i
StateDirectoryMode=0700

# 沙箱
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
