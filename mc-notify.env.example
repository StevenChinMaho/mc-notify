# ============================================================
# mc-notify 設定檔範例
# 放在 /etc/mc-notify/<伺服器名稱>.env，權限 root:root 600
# 只有 MC_WEBHOOK_URL 和 MC_RCON_PASSWORD 是必填，其他都有預設值
#
# 格式注意（systemd EnvironmentFile）：
#   - 註解必須獨立一行，不能寫在值的後面
#   - 值可以包含空白，不需要加引號
#   - 被 # 註解掉的設定會使用預設值
# 完整說明：docs/configuration.md
# ============================================================

# ---------- 必填 ----------
MC_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
MC_RCON_PASSWORD=跟server.properties的rcon.password一樣

# ---------- 伺服器 ----------
MC_SERVER_NAME=我的模組服
MC_LOG_PATH=/srv/minecraft/modpack/logs/latest.log
# 伺服器根目錄，用來解析相對路徑的 crash report（預設：log 路徑往上兩層）
#MC_SERVER_DIR=/srv/minecraft/modpack
#MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575

# ---------- Discord 外觀 ----------
# 發送者頭像（需要是公開的圖片網址），留空 = 用 webhook 本身的頭像
#MC_AVATAR_URL=https://example.com/modpack-icon.png

# ---------- TPS 監控 ----------
# Forge: forge tps / NeoForge: neoforge tps / 原版或 Fabric 1.20.3+: tick query
# 留空 = 不監控 TPS，只檢查伺服器是否存活（1.20.3 以前的原版）
MC_TPS_COMMAND=forge tps
MC_TPS_THRESHOLD=19.5
# 每幾秒查詢一次
MC_POLL_INTERVAL=30
# 連續幾次低於門檻才通知（10 × 30 秒 = 5 分鐘）
MC_LOW_TPS_COUNT=10
# RCON 連續失敗幾次視為無回應
MC_DOWN_COUNT=3

# ---------- 通知行為 ----------
# 可用的事件名稱：
#   players  玩家加入/退出      start    伺服器已啟動
#   stop     伺服器正在關閉     crash    伺服器崩潰
#   down     伺服器無回應       up       伺服器恢復回應
#   tps_low  TPS 持續過低       tps_ok   TPS 已恢復

# 玩家進出通知開關
MC_NOTIFY_PLAYERS=true

# 要 ping 的身分組 ID（Discord 開發者模式 → 右鍵身分組 → 複製 ID），留空 = 不 ping
#MC_PING_ROLE_ID=123456789012345678
# 哪些事件要 ping（逗號分隔）
MC_PING_EVENTS=crash,down

# 哪些事件用靜音訊息發送（頻道仍會顯示，但不會推播），留空 = 全部正常推播
MC_SILENT_EVENTS=players

# ---------- Crash report ----------
# 崩潰時附上 crash report 檔案
MC_ATTACH_CRASH_REPORT=true
# 附件大小上限（MB），超過會只附前段內容
MC_ATTACH_MAX_MB=8

# ---------- 狀態看板 ----------
# 開啟後會發一則訊息並持續編輯它，顯示運作狀態、玩家、TPS
MC_STATUS_BOARD=false
# 每幾秒更新一次（最小 10）
MC_STATUS_INTERVAL=60
# 存放看板訊息 ID 的目錄，重啟後才能沿用同一則訊息
# 使用 systemd 的 StateDirectory= 時會自動設定，不用填
#MC_STATE_DIR=/var/lib/mc-notify/modpack
